# Generate a unique persistent value for each secret before running locally.
PHONE_ENCRYPTION_KEY=
PHONE_LOOKUP_SECRET=
DATABASE_URL=sqlite:///./localgrowth.db
THANK_YOU_DELAY_SECONDS=420
PROMOTIONAL_SUPPRESSION_HOURS=168
JOB_WORKER_INTERVAL_SECONDS=1
WHATSAPP_MODE=test
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEST_ALLOWED_RECIPIENTS=
WHATSAPP_TEST_RECIPIENT_VERIFIED=false
WHATSAPP_TEST_TEMPLATE_NAME=
WHATSAPP_TEST_TEMPLATE_LANGUAGE=
WHATSAPP_TEST_TEMPLATE_COMPONENTS=[]
WHATSAPP_REQUEST_TIMEOUT_SECONDS=15
# Separate from the access token. Set locally before enabling the webhook listener.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Automatic real test sending is OFF by default. Only this purchase key can opt in.
WHATSAPP_AUTOMATION_MODE=simulation
WHATSAPP_AUTOMATION_ENABLED=false
WHATSAPP_AUTOMATION_PURCHASE_KEY=
